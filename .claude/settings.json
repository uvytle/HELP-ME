{
  "permissions": {
    "allow": [
      "EnterWorktree",
      "ExitWorktree",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push)",
      "Bash(git push origin *)",
      "Bash(git push -u origin *)",
      "Bash(git pull)",
      "Bash(git pull *)",
      "Bash(git fetch)",
      "Bash(git fetch *)",
      "Bash(git branch)",
      "Bash(git branch *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git worktree add *)",
      "Bash(git worktree list*)",
      "Bash(git worktree remove *)",
      "Bash(gh pr create*)",
      "Bash(gh pr view*)",
      "Bash(gh pr merge*)",
      "Bash(gh pr list*)",
      "Bash(gh pr checkout*)",
      "Bash(gh repo view*)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push origin * --force*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(git branch -D*)",
      "Bash(git branch --delete --force*)",
      "Bash(git worktree remove --force*)",
      "Bash(git worktree remove -f*)",
      "Bash(git rebase -i*)",
      "Bash(gh repo delete*)",
      "Bash(gh repo edit --visibility*)"
    ]
  }
}
